/*
 * Corne XIAO (shield corny) - 44 posicoes
 *
 * Ordem das posicoes (importa pros combos):
 *   linha 0:  0..11
 *   linha 1: 12..23
 *   linha 2: 24..29 (esq) | 30 31 (centrais SW22) | 32..37 (dir)
 *   linha 3: 38..40 (esq) | 41..43 (dir)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
  behaviors {
    hm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      label = "HOMEROW_MODS";
      #binding-cells = <2>;
      tapping-term-ms = <150>;
      quick-tap-ms = <0>;
      flavor = "tap-preferred";
      bindings = <&kp>, <&kp>;
    };
  };

  combos {
    compatible = "zmk,combos";

    tab {
      bindings = <&trans>;
      key-positions = <2 3>;
    };

    ctrl {
      bindings = <&kp LCTRL>;
      key-positions = <26 27>;
    };

    // reindexado de <37 38> (layout 42) para <39 40> (layout 44)
    cmd {
      bindings = <&kp LCMD>;
      key-positions = <39 40>;
    };

    // reindexado de <39 40> para <41 42>
    alt {
      bindings = <&kp LEFT_ALT>;
      key-positions = <41 42>;
    };

    shift {
      bindings = <&kp LSHIFT>;
      key-positions = <8 9>;
    };

    caps_word {
      bindings = <&caps_word>;
      key-positions = <17 18>;
    };

    // reindexado de <32 33> para <34 35>
    delete {
      bindings = <&kp DEL>;
      key-positions = <34 35>;
    };
  };

  macros {
    zed_em_kay: zed_em_kay {
      compatible = "zmk,behavior-macro";
      label = "ZM_zed_em_kay";
      #binding-cells = <0>;
      bindings =
        <&macro_press>,
        <&kp LSHFT>,
        <&macro_tap>,
        <&kp Z &kp M &kp K>,
        <&macro_release>,
        <&kp LSHFT>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    base {
      display-name = "Base";
      bindings = <
&kp TAB    &kp Q       &kp W       &kp E        &kp R         &kp T                                     &kp Y    &kp U         &kp I        &kp O       &kp P          &kp BACKSPACE
&kp LCTRL  &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHIFT F  &kp G                                     &kp H    &hm RSHIFT J  &hm RCTRL K  &hm RALT L  &hm RGUI SEMI  &kp APOS
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V         &kp B         &kp C_MUTE     &none        &kp N    &kp M         &kp COMMA    &kp DOT     &kp FSLH       &kp ESC
                                   &kp LGUI     &mo 1         &kp SPACE                                 &kp RET  &mo 2         &kp RALT
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
    };

    raise {
      display-name = "Raise";
      bindings = <
&trans            &kp N1  &kp N2          &kp N3        &kp N4          &kp N5                              &kp N6             &kp N7          &kp N8         &kp N9           &kp N0           &kp BACKSPACE
&kp LEFT_CONTROL  &trans  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW                     &kp LEFT_ARROW     &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT_ARROW  &kp EQUAL        &kp MINUS
&kp LEFT_SHIFT    &trans  &trans          &trans        &trans          &trans           &trans     &trans   &trans             &trans          &trans         &trans           &kp KP_MULTIPLY  &kp SLASH
                                          &kp LEFT_ALT  &trans          &kp LEFT_COMMAND                    &kp RIGHT_COMMAND  &mo 3           &kp RIGHT_ALT
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
    };

    lower {
      display-name = "Lower";
      bindings = <
&kp GRAVE         &kp EXCL  &kp AT  &kp HASH      &kp DLLR  &kp PRCNT                        &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR   &kp BACKSPACE
&kp LEFT_CONTROL  &kp F1    &kp F2  &kp F3        &kp F4    &kp F5                           &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH   &kp GRAVE
&kp LEFT_SHIFT    &kp F6    &kp F7  &kp F8        &kp F9    &kp F10    &trans     &trans     &kp F11    &kp F12    &kp LBRC         &kp RBRC  &kp SLASH  &kp RIGHT_SHIFT
                                    &kp LEFT_ALT  &mo 3     &kp LEFT_COMMAND                 &trans     &trans     &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
    };

    both {
      display-name = "System";
      bindings = <
&studio_unlock  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans         &trans        &trans                            &trans  &kp K_BACK         &kp K_PLAY_PAUSE  &kp K_NEXT  &trans  &ind_bat
&trans          &kp HOME              &kp PAGE_UP           &kp PAGE_DOWN  &kp END       &trans                            &trans  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &kp K_MUTE  &trans  &ind_con
&bt BT_CLR      &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4  &trans     &trans   &trans  &trans             &trans            &trans      &trans  &trans
                                                            &trans         &trans        &trans                            &trans  &trans             &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
    };
  };
};
