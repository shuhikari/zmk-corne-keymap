if SHIELD_CORNY_LEFT

# Nome deliberadamente diferente do firmware de fabrica ("Chippy"):
# depois de flashear, o dispositivo USB deve aparecer como "Corny".
# Se ainda aparecer "Chippy", o flash nao pegou.
config ZMK_KEYBOARD_NAME
    default "Corny"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_CORNY_RIGHT

config ZMK_KEYBOARD_NAME
    default "Corny Right"

endif

if SHIELD_CORNY_LEFT || SHIELD_CORNY_RIGHT

config ZMK_SPLIT
    default y

endif
