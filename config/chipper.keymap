/*
 * Corne 6-col (shield chipper) - 42 posicoes
 *
 * Ordem das posicoes (usada pelos combos):
 *   linha 0:  0..11
 *   linha 1: 12..23
 *   linha 2: 24..35
 *   linha 3: 36..38 (esq) | 39..41 (dir)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// behaviors &ind_bat / &ind_con do modulo zmk-rgbled-widget
#include <behaviors/rgbled_widget.dtsi>

/ {
  behaviors {
    hm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      label = "HOMEROW_MODS";
      #binding-cells = <2>;
      // 280ms: folga suficiente pra digitacao normal nao virar modificador.
      flavor = "balanced";
      tapping-term-ms = <280>;
      // ignora o hold nos primeiros 150ms depois de qualquer tecla: e o que
      // impede o disparo acidental no meio de uma palavra.
      require-prior-idle-ms = <150>;
      // segurar logo apos tocar a mesma tecla repete a letra em vez de segurar o mod.
      quick-tap-ms = <175>;
      bindings = <&kp>, <&kp>;
    };
  };

  combos {
    compatible = "zmk,combos";

    tab       { bindings = <&trans>;         key-positions = <2 3>; };
    ctrl      { bindings = <&kp LCTRL>;      key-positions = <26 27>; };
    cmd       { bindings = <&kp LCMD>;       key-positions = <37 38>; };
    alt       { bindings = <&kp LEFT_ALT>;   key-positions = <39 40>; };
    shift     { bindings = <&kp LSHIFT>;     key-positions = <8 9>; };
    caps_word { bindings = <&caps_word>;     key-positions = <17 18>; };
    delete    { bindings = <&kp DEL>;        key-positions = <32 33>; };
  };

  macros {
    zed_em_kay: zed_em_kay {
      compatible = "zmk,behavior-macro";
      label = "ZM_zed_em_kay";
      #binding-cells = <0>;
      bindings =
        <&macro_press>,
        <&kp LSHFT>,
        <&macro_tap>,
        <&kp Z &kp M &kp K>,
        <&macro_release>,
        <&kp LSHFT>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    base {
      display-name = "Base";
      bindings = <
&kp TAB    &kp Q       &kp W       &kp E        &kp R         &kp T        &kp Y    &kp U         &kp I        &kp O       &kp P          &kp BACKSPACE
&kp LCTRL  &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHIFT F  &kp G        &kp H    &hm RSHIFT J  &hm RCTRL K  &hm RALT L  &hm RGUI SEMI  &kp APOS
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V         &kp B        &kp N    &kp M         &kp COMMA    &kp DOT     &kp FSLH       &kp ESC
                                   &kp LGUI     &mo 1         &kp SPACE    &kp RET  &mo 2         &kp RALT
      >;
    };

    raise {
      display-name = "Raise";
      bindings = <
&kp ESC           &kp N1  &kp N2          &kp N3        &kp N4          &kp N5              &kp N6             &kp N7          &kp N8         &kp N9           &kp N0           &kp BACKSPACE
&kp LEFT_CONTROL  &trans  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW     &kp LEFT_ARROW     &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT_ARROW  &kp EQUAL        &kp MINUS
&kp LEFT_SHIFT    &trans  &trans          &trans        &trans          &trans              &trans             &trans          &trans         &trans           &kp KP_MULTIPLY  &kp SLASH
                                          &kp LEFT_ALT  &trans          &kp LEFT_COMMAND    &kp RIGHT_COMMAND  &mo 3           &kp RIGHT_ALT
      >;
    };

    lower {
      display-name = "Lower";
      bindings = <
&kp GRAVE         &kp EXCL  &kp AT  &kp HASH      &kp DLLR  &kp PRCNT           &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR   &kp BACKSPACE
&kp LEFT_CONTROL  &kp F1    &kp F2  &kp F3        &kp F4    &kp F5              &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH   &kp GRAVE
&kp LEFT_SHIFT    &kp F6    &kp F7  &kp F8        &kp F9    &kp F10             &kp F11    &kp F12    &kp LBRC         &kp RBRC  &kp SLASH  &kp RIGHT_SHIFT
                                    &kp LEFT_ALT  &mo 3     &kp LEFT_COMMAND    &trans     &trans     &trans
      >;
    };

    both {
      display-name = "System";
      bindings = <
&studio_unlock  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans         &trans        &trans          &trans  &kp K_BACK         &kp K_PLAY_PAUSE  &kp K_NEXT  &trans  &ind_bat
&trans          &kp HOME              &kp PAGE_UP           &kp PAGE_DOWN  &kp END       &trans          &trans  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &kp K_MUTE  &trans  &ind_con
&bt BT_CLR      &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans             &trans            &trans      &trans  &to 4
                                                            &trans         &trans        &trans          &trans  &trans             &trans
      >;
    };

    // Modo jogo: QWERTY puro, SEM home row mods (num jogo eles disparariam
    // modificador sem querer). Sai com a tecla `Base` no canto inferior direito.
    game {
      display-name = "Game";
      bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R   &kp T        &kp Y    &kp U   &kp I      &kp O    &kp P     &kp BACKSPACE
&kp LSHFT  &kp A  &kp S  &kp D     &kp F   &kp G        &kp H    &kp J   &kp K      &kp L    &kp SEMI  &kp APOS
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V   &kp B        &kp N    &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &kp LALT  &mo 1   &kp SPACE    &kp RET  &mo 2   &to 0
      >;
    };

    // Camadas livres: existem no firmware para o ZMK Studio poder edita-las
    // sem precisar recompilar. Vazias de proposito.
    spare1 {
      display-name = "Livre 1";
      bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
      >;
    };

    spare2 {
      display-name = "Livre 2";
      bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
      >;
    };
  };
};
